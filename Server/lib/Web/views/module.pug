-
	const MENU = [
		{ key: 'HOME', href: "http://jjo.kr/" },
	];
	const PUBLIC = locals.published;
	
	var DATA = locals.data || {};
	var LANG = locals.locale;
	var SESSION = locals.session;

	function L(id){
		var R = LANG[id] || "(L#"+id+")", i;
		
		R = R.toString();
		for(i=1; arguments[i]; i++) R = R.replace(new RegExp("{V"+i+"}", 'g'), arguments[i]);
		return R.replace(/FA\{[^\}]+\}/g, _L_Replace);
	}
	function _L_Replace(seq){ return "<i class='fa fa-"+seq.slice(3, seq.length-1)+"'></i>"; }
	
	function zeroPadding(num, len){ var s = num.toString(); return "000000000000000".slice(0, Math.max(0, len - s.length)) + s; }
	function strcmp(s1, s2){ return (s1 == s2) ? 0 : ((s1 > s2) ? 1 : -1); }
	Date.prototype.toYYYYMMDD = function(){
		var i, res = [this.getFullYear(), this.getMonth() + 1, this.getDate()];
		
		for(i in res) res[i] = ((res[i] < 10) ? "0" : "") + res[i];
		return res.join("").toString();
	};

mixin Menu()
	div.Menu
		- for(i in MENU)
			- if(MENU[i].href)
				button.menu-btn(id='menu-item-'+MENU[i].key, onclick='location.href = "'+MENU[i].href+'";')!= L(MENU[i].key)
			- else if(MENU[i].sub)
				div.menu-btn(id='menu-item-'+MENU[i].key)!= L(MENU[i].key)
					div.menu-sub-separator
					- for(j in MENU[i].sub)
						div.menu-sub-btn(onclick='location.href = "'+MENU[i].sub[j].href+'";')!= L(MENU[i].sub[j].key)
		div#account
			span#profile= SESSION.profile ? JSON.stringify(SESSION.profile) : '{}'
			div#account-info

mixin MMenu()
	div.Menu
		div#account
			span#profile= SESSION.profile ? JSON.stringify(SESSION.profile) : '{}'
			div#account-info

mixin Image(c, url)
	div(class="jt-image "+c, style="background-image: url("+url+");")
		if block
			block

mixin FA(id)
	i(class="fa fa-"+id)

mixin separator(len)
	div(style="float: left; width: 100%; margin: "+len+"px 0px;")
	
mixin PageHead(min)
	if !min
		link(rel='stylesheet', href=((locals.mobile && !locals.as_pc) ? '/css/m_style.css' : '/css/style.css') + '?v=room-chain-bg1')
		link(rel='stylesheet', href='/css/fa.css')
		link(rel='stylesheet', href='/css/expl.css')
	script(type='text/javascript', src='/js/jquery.js')
	script(type='text/javascript', src='/language/'+locals.page.replace("/", "_")+'/'+locals.lang)
	
	if PUBLIC && !SESSION.admin
		//script(type='text/javascript', src='/js/google.js')
	script(type='text/javascript', src='/js/global.min.js')
	if !min
		//script(type='text/javascript', src='/js/facebook.js')
		if block
			block
		link(rel='stylesheet', href='/css/in_'+locals.page.replace("/", "_")+'.css?v=room-header-palette1-clan-banner-rollback1-main-word-pulse1')
		if locals.page != 'kkutu' && locals.page != 'm_kkutu'
			script(type='text/javascript', src='/js/in_'+locals.page.replace("/", "_")+'.min.js')
	
mixin SearchBox(arg1, arg2)
	meta(name='description', content=L('meta_desc', arg1, arg2))
	meta(name='keywords', content=L('meta_keys', arg1, arg2))

mixin Expl(text, width)
	- if(text == undefined) return;
	div.expl(style='width: '+(width ? (width + 'px') : 'initial'))
		if block
			block
		else
			h5= text

mixin Product(id, initiallyHidden)
	div(class=id+'Box Product', style=initiallyHidden ? 'display: none;' : null)
		h5.product-title!= L(id)
		div.product-body
			if block
				block
			else
				h4= id
		if id == 'UserList' && !locals.mobile
			div#online-myinfo-card.online-myinfo-card(role='button', tabindex='0', aria-label='My Info')
				div.online-myinfo-head
					i.fa.fa-user(aria-hidden='true')
					span My Info
				div.online-myinfo-body
					div.online-myinfo-avatar-wrap
						div.moremi.online-myinfo-avatar
					div.online-myinfo-side
						div.online-myinfo-name-row
							div.online-myinfo-level-img
							span.online-myinfo-name -
						div.online-myinfo-record -
					div.online-myinfo-level-text LV 1
					div.online-myinfo-xp
						div.online-myinfo-xp-fill
						div.online-myinfo-xp-text 0 / 0
			div#userlist-toggle.userlist-toggle(role='button', aria-label='Toggle user list', title='Toggle user list')
				span.userlist-toggle-icon.userlist-toggle-collapse &lt;
				span.userlist-toggle-icon.userlist-toggle-expand &gt;

mixin GraphBar(c, min, val, max, bgc)
	div(class='graph '+c)
		div.graph-bar(style='width: '+((val-min) / (max-min) * 100)+'%;'+(bgc ? (' background-color: '+bgc+';') : ''))

mixin ChartBar(c, data)
	-
		var i, sum = 0, total = 100;
		
		for(i in data) sum += data[i].value;
		data[data.length - 1].last = true;
	
	div(class='chart '+c)
		- for(i in data)
			- var r = data[i].last ? total : (data[i].value / sum * 100);
			- total -= r;
			div.chart-bar.ellipse(style='width: '+r+'%; background-color: '+data[i].color+';')= data[i].label || ''
				+Expl(data[i].label ? (data[i].label + ' ' + r.toFixed(1) + '%') : undefined)
