extends layout

block Subject
	title *** JJO.KR 관리 페이지 ***

block JS
	script(type="text/javascript", src="/js/in_admin.min.js")
	script(type="text/javascript", src="/js/in_admin_fix.js?v=20260315-dictrequests1")
	
block Middle
	div#gwalli
		div.gwalli-nav
			a(href='#gwalli-auth') 자격
			a(href='#gwalli-injeong') 추가 요청
			a(href='#gwalli-shop') 상점
			a(href='#gwalli-users') 유저
			a(href='#gwalli-gamsi') 감시
			a(href='#gwalli-kkutudb') 끄투 DB
			a(href='#gwalli-kkutuadd') 단어 추가
			a(href='#gwalli-kkutuhot') 인기 단어
			a(href='#gwalli-dictrequests') Word Requests
		fieldset.gwalli-section#gwalli-auth
			legend 자격
			div.gwalli-row
				input#db-password(type='password', placeholder='암호')
				select#db-lang
					option(value='ko') ko
					option(value='en') en
		fieldset.gwalli-section#gwalli-injeong
			legend 추가 요청 받기
			div.gwalli-section-body
				div.gwalli-row
					button#injeong-go 조회
				div.gwalli-table
					table
						thead: tr
							td 승인?
							td 링크
							td #
							td theme
							td writer
							td createdAt
						tbody#injeong-data
				div.gwalli-row
					button#injeong-everything 모두 승인
					button#injeong-nothing 모두 거절
					button#injeong-apply 적용
		fieldset.gwalli-section#gwalli-shop
			legend 상점 DB 다루기
			div.gwalli-section-body
				div.gwalli-row
					input#shop-word(placeholder='품목 (~ALL)')
					button#shop-go 조회
					button#shop-hide 숨기기
				div.gwalli-table
					table
						thead: tr
							td #
							td cost
							td hit
							td term
							td group
							td updatedAt
							td options
							td name_ko_KR
							td desc_ko_KR
							td name_en_US
							td desc_en_US
						tbody#shop-data
				div.gwalli-row
					button#shop-add 추가
					button#shop-apply 적용
		fieldset.gwalli-section#gwalli-users
			legend 유저 DB 다루기
			div.gwalli-section-body
				div.gwalli-row
					input#user-id(placeholder='ID')
					input#user-nick(placeholder='닉네임')
					button#user-go 조회
				div.gwalli-table
					table
						thead: tr
							td #
							td money
							td kkutu
							td box
							td equip
							td exordial
							td server
							td lastLogin
							td black
							td blockedUntil
							td friends
						tbody#user-data
				div.gwalli-row
					button#user-apply 적용
		fieldset.gwalli-section#gwalli-gamsi
			legend 유저 감시하기
			div.gwalli-section-body
				div.gwalli-row
					input#gamsi-id(placeholder='ID (,로 구분)')
					button#gamsi-go 감시
				div.gwalli-table
					table
						thead: tr
							td #
							td 닉네임
							td 서버
						tbody#gamsi-data
		fieldset.gwalli-section#gwalli-dictrequests
			legend Word Requests
			div.gwalli-section-body
				div.gwalli-row
					button#dict-requests-refresh Refresh
				div.gwalli-table
					table
						thead: tr
							td word
							td lang
							td requester
							td createdAt
							td action
						tbody#dict-requests-data
		fieldset.gwalli-section#gwalli-kkutudb
			legend 끄투 DB 다루기
			div.gwalli-section-body
				div.gwalli-row
					input#db-word(placeholder='단어')
					button#db-go 조회
					button#db-new-word New Word
				div#gwalli-new-word.gwalli-new-word
					div.gwalli-row
						input#new-word-id(placeholder='word')
						select#new-word-subject
						select#new-word-type
					textarea#new-word-definition(rows=5, placeholder='definition')
					div.gwalli-row
						button#new-word-create Create
				div#word-data
					div#wd-id
					input#wd-flag
					div.gwalli-table
						table
							thead: tr
								td #
								td type
								td theme
								td mean
								td 행동
							tbody#wd-data
				div#word-flag
				div#word-hit
				div.gwalli-row
					button#db-delete Delete
					button#word-add 추가
					button#db-apply 적용
		fieldset.gwalli-section#gwalli-kkutuadd
			legend 끄투 DB에 단어 추가하기
			div.gwalli-section-body
				div.gwalli-row
					input#db-theme(placeholder='주제 (~부터 적으면 검색)')
				textarea#db-list(rows=20, cols=100)
				div.gwalli-row
					button#db-ok 확인
		fieldset.gwalli-section#gwalli-kkutuhot
			legend 끄투에서의 인기 단어
			div.gwalli-section-body
				div.gwalli-row
					button#kpw-query 조회
					button#kpw-flush 반영
				textarea#kpw-html
				div#kpw-table
