block Top
	- var topProfile = SESSION.profile || {};
	- var topName = topProfile.title || topProfile.name || L('guest');
	- var topImage = (typeof topProfile.image === "string") ? topProfile.image.trim() : "";
	- var topIsGuest = !!SESSION.guest || /^guest/i.test(String(topName || ""));
	- var topFallbackImage = topIsGuest ? "/img/kkutu/guest.png" : "/img/kkutu/moremi/body_fla.png";
	- if(!topImage && (String(topProfile.authType || topProfile.type || "").toLowerCase() === "google" || /^\d{16,}$/.test(String(topProfile.id || ""))) && topProfile.id){
	- 	topImage = "https://profiles.google.com/s2/photos/profile/" + encodeURIComponent(topProfile.id) + "?sz=256";
	- }
	- if(topImage && topImage.indexOf("//") === 0) topImage = "https:" + topImage;
	- if(topImage && /^http:\/\//i.test(topImage)) topImage = "https://" + topImage.slice(7);
	- if(topImage && /^https?:\/\//i.test(topImage)){
	- 	var hostMatch = topImage.match(/^https?:\/\/([^\/?#]+)/i);
	- 	var topHost = hostMatch ? hostMatch[1].toLowerCase() : "";
	- 	if(/(^|\.)googleusercontent\.com$/.test(topHost) || /(^|\.)ggpht\.com$/.test(topHost) || /(^|\.)googleapis\.com$/.test(topHost) || /(^|\.)google\.com$/.test(topHost) || /(^|\.)gstatic\.com$/.test(topHost)){
	- 		topImage = "/profile-image?u=" + encodeURIComponent(topImage);
	- 	}
	- }
	- if(!topImage || topImage === "[object Object]" || topImage === "undefined" || topImage === "null") topImage = topFallbackImage;
	div#top-profile-card
		div.top-profile-myinfo-deco(aria-hidden='true')
		div.top-profile-main(role='button', aria-label=L('Me'))
			div.top-profile-avatar.jt-image(style=`background-image: url('${topImage}'), url('${topFallbackImage}');`)
			div.top-profile-meta
				div.top-profile-title
					div.top-profile-level-img
					div.top-profile-name= topName
					button#top-login-btn.top-profile-login(type='button', style='display: none;')= L('LOGIN')
				div.top-profile-level-row
					div.top-profile-level-text LV 1
					div.top-profile-level-bar.graph
						div.graph-bar(style='width: 0%;')
		div.top-profile-spacer
		div.top-profile-gems
		button#top-help-btn.top-profile-settings(type='button')
			+FA('question')
		button#top-notice-btn.top-profile-settings(type='button')
			+FA('bell')
			span.top-notice-count(style='display: none;') 0
		button#top-settings-btn.top-profile-settings(type='button')
			+FA('cog')

